# local = localStorage/offline; prod = Firebase Auth + Firestore realtime
APP_ENV=local
HOME_NAME=Hotel Trường An Hotel
HOME_LAT=11.9370985
HOME_LNG=108.4220004
DEFAULT_TRIP_SLUG=dalat-2026
DEFAULT_TRIP_NAME=Đà Lạt 2026
OPENROUTESERVICE_API_KEY=
ORS_BASE_URL=https://api.heigit.org

# Required only for APP_ENV=prod. Copy from Firebase Console > Project settings > Your apps > Web app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTO_SEED_DEFAULTS=true

UI_EYEBROW=ĐÀ LẠT · TRIP COMPANION
